#include <stdio.h>
int main() 
{
    int page_size, num_pages;
    // Input page size and number of pages
    printf("Enter page size: ");
    scanf("%d", &page_size);
    printf("Enter number of pages: ");
    scanf("%d", &num_pages);
    int page_table[num_pages];
    // Input page table
    printf("Enter frame number for each page:\n");
    for(int i = 0; i < num_pages; i++) {
        printf("Page %d -> Frame: ", i);
        scanf("%d", &page_table[i]);
    }
    int logical_address;
    // Input logical address
    printf("\nEnter logical address: ");
    scanf("%d", &logical_address);
    // Calculate page number and offset
    int page_number = logical_address / page_size;
    int offset = logical_address % page_size;

    // Check for valid page number
    if(page_number >= num_pages) {
        printf("Error: Invalid logical address (Page number out of range)\n");
        return 1;
    }
    // Get frame number from page table
    int frame_number = page_table[page_number];
    // Calculate physical address
    int physical_address = (frame_number * page_size) + offset;
    // Output results
    printf("\nPage Number: %d\n", page_number);
    printf("Offset: %d\n", offset);
    printf("Frame Number: %d\n", frame_number);
    printf("Physical Address: %d\n", physical_address);

    return 0;
}
