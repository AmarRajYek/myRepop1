+++++++++++++++++++++++++++++++++++++++++++++++++++>>>ARmstrong+++++++++++++++++++++++++++++++++++++++++++++++++++
public class Armstrong {
    public static boolean isArmstrong(int n) {
        int original = n, sum = 0, digits = String.valueOf(n).length();
        while (n != 0) {
            int digit = n % 10;
            sum += (int) Math.pow(digit, digits); // power is 'digits'
            n /= 10;
        }
        return sum == original;
    }
public static void main(String[] args) {
    //void main(){
        System.out.println("Result is : "+isArmstrong(67));     
}
}

