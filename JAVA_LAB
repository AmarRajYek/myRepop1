+++++++++++++++++++++++++++++++++++++++++++++++++++>>>Producer==Consumer+++++++++++++++++++++++++++++++++++++++++++++++++++
class Buffer{
    int data;
    boolean avail = false;

    synchronized void produce(int value){
        try {
            while(avail){
                wait();
            }

            data = value;

            System.out.println("Produced : " + data);

            avail = true;

            notify();

        } catch (InterruptedException e) {
            e.printStackTrace();
        }
    }

    // consume method
    synchronized void consume(){
        try {

            while(!avail){
                wait();
            }

            System.out.println("Consumed : " + data);

            avail = false;

            notify();

        } catch (InterruptedException e) {
            e.printStackTrace();
        }
    }
}

class Producer extends Thread{

    Buffer b;

    Producer(Buffer b){
        this.b = b;
    }

    public void run(){

        for(int i = 0; i < 5; i++){

            b.produce(i);

        }
    }
}

class Consumer extends Thread{

    Buffer b;

    Consumer(Buffer b){
        this.b = b;
    }

    public void run(){

        for(int i = 0; i < 5; i++){

            b.consume();

        }
    }
}
public class Threads2{

    public static void main(String[] args) {

        Buffer b = new Buffer();

        Producer p = new Producer(b);

        Consumer c = new Consumer(b);

        p.start();

        c.start();
    }
}

