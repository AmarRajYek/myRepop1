int request[] = {53, 183, 37, 122, 14, 124, 65, 67}; 
int n = sizeof(request) / sizeof(request[0]); 
int head = 53; 
printf("Initial head position: %d\n", head); 
printf("Request queue: "); 
for (int i = 0; i < n; i++) { 
printf("%d ", request[i]); 
} 
printf("\n"); 
scanDiskSchedule(request, n, head); 
return 0; 
