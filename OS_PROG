========================================>>>>>>>>>>>> Deadlock Avoidence
#include<stdio.h>

struct process
{
    int all[10], max[10], need[10], flag;
};

int main()
{
    struct process p[10];

    int n, r, i, j, k;
    int avail[10], seq[10];
    int count = 0, fl = 0, safe = 1;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter number of resources: ");
    scanf("%d", &r);

    // Input Allocation & Max
    for(i = 0; i < n; i++)
    {
        printf("\nEnter details for P%d\n", i);

        printf("Allocation: ");
        for(j = 0; j < r; j++)
            scanf("%d", &p[i].all[j]);

        printf("Max: ");
        for(j = 0; j < r; j++)
        {
            scanf("%d", &p[i].max[j]);

            // Need Calculation
            p[i].need[j] = p[i].max[j] - p[i].all[j];
        }

        p[i].flag = 0;
    }

    // Available Resources
    printf("\nEnter Available Resources: ");
    for(i = 0; i < r; i++)
        scanf("%d", &avail[i]);

    // Banker's Algorithm
    while(count != n)
    {
        int found = 0;

        for(i = 0; i < n; i++)
        {
            if(p[i].flag == 0)
            {
                int possible = 1;

                for(j = 0; j < r; j++)
                {
                    if(p[i].need[j] > avail[j])
                    {
                        possible = 0;
                        break;
                    }
                }

                // Process can execute
                if(possible)
                {
                    printf("\nP%d is visited", i);

                    seq[fl++] = i;
                    p[i].flag = 1;

                    for(k = 0; k < r; k++)
                        avail[k] += p[i].all[k];

                    count++;
                    found = 1;
                }
            }
        }

        // Unsafe State
        if(found == 0)
        {
            safe = 0;
            break;
        }
    }

    // Output
    if(safe)
    {
        printf("\n\nSYSTEM IS IN SAFE STATE");

        printf("\nSafe Sequence: ");
        for(i = 0; i < fl; i++)
            printf("P%d ", seq[i]);
    }
    else
    {
        printf("\nSYSTEM IS IN UNSAFE STATE");
    }

    // Table Display
    printf("\n\nProcess\tAllocation\tMax\tNeed\n");

    for(i = 0; i < n; i++)
    {
        printf("P%d\t", i);

        for(j = 0; j < r; j++)
            printf("%3d", p[i].all[j]);

        printf("\t");

        for(j = 0; j < r; j++)
            printf("%3d", p[i].max[j]);

        printf("\t");

        for(j = 0; j < r; j++)
            printf("%3d", p[i].need[j]);

        printf("\n");
    }
return 0;
}

